pkgver() {
  cd "${srcdir}/rtl8852cu-20251113"
  printf '1.19.22.103.r%s.g%s' \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

package() {
  local _dest="${pkgdir}/usr/src/${_pkgbase}-${pkgver}"
  install -dm755 "${_dest}"
  cd "${srcdir}/rtl8852cu-20251113"

  # DKMS builds the module after installation. Do not execute the
  # upstream install-driver.sh script or configure module blacklists.
  find . -mindepth 1 -maxdepth 1 ! -name '.git' \
    -exec cp -a --no-preserve=ownership -- '{}' "${_dest}/" \;

  sed -i \
    -e "s/^PACKAGE_NAME=.*/PACKAGE_NAME=\"${_pkgbase}\"/" \
    -e "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"${pkgver}\"/" \
    "${_dest}/dkms.conf"

  # Keep the upstream DKMS build helper executable.
  chmod 755 "${_dest}/dkms-make.sh"
}
